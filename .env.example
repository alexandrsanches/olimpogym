# Copie para .env e preencha. NUNCA envie o .env para o GitHub.

# Administrador criado automaticamente na primeira vez que o sistema sobe (sem nenhum usuário no banco).
# Depois de entrar, troque a senha em "Minha conta". Mudar estes valores depois não altera o usuário existente.
ADMIN_NOME=Administrador
ADMIN_EMAIL=voce@olimpogym.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Deixe "true" em produção (HTTPS). Use "false" apenas para testar sem HTTPS.
COOKIE_SECURE=true
